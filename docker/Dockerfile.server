FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/netbridge-server ./server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 65532 app
USER app
COPY --from=build /out/netbridge-server /netbridge-server
ENV BIND_ADDR=0.0.0.0
EXPOSE 8080
ENTRYPOINT ["/netbridge-server"]
